# Copy this file to ".env" and fill in your own values.
# ".env" is listed in .gitignore, so your real password is never committed.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sunrise_dental
DB_USERNAME=root
DB_PASSWORD=changeme

# --- Server ---
SERVER_PORT=8080

# --- Email reminders (optional, FR7) ---
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Set to true only when the app is served over HTTPS ---
COOKIE_SECURE=false
