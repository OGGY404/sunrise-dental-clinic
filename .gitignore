# ---- Maven build output ----
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ---- Secrets: never commit real credentials ----
.env
*.env
!.env.example
application-local.properties
src/main/resources/application-local.properties

# ---- IntelliJ IDEA ----
.idea/
*.iws
*.iml
*.ipr

# ---- Eclipse / STS ----
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/

# ---- NetBeans ----
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ---- VS Code ----
.vscode/

# ---- Logs and temp files ----
*.log
logs/
*.tmp
*.bak

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Test / coverage reports (regenerated by the build) ----
/coverage/
.jacoco/

# Report build intermediates (regenerate with docs/report/build-pdf.py)
docs/report/doc-images/
docs/report/_final.md
docs/report/_final_pandoc.md
docs/report/_reference.docx
docs/report/~$*
